@model IReadOnlyList<TechJs.MVC.Sample.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Product Management</h1>

            <p class="text-muted mb-0">
                Tech.js MVC Sample
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-tech="button"
                data-tech-url="/Products/Create"
                data-tech-target="#product-form"
                data-tech-complete="showProductFormModal"
                data-tech-swap="inner">
            Add Product
        </button>
        <button type="button"
                id="refreshProducts"
                class="btn btn-primary"
                data-tech="button"
                data-tech-url="/Products/List"
                data-tech-method="GET"
                data-tech-target="#product-list"
                data-tech-swap="inner">
                Refresh List
        </button>

    </div>


    <div class="modal fade"
         id="productModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Add Product
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body"
                     id="product-form">
                </div>

            </div>

        </div>

    </div>


    <div id="product-list"
         class="card">

        <div class="card-body p-0">

            @await Html.PartialAsync(
            "_ProductList",
                        Model)

        </div>

    </div>

</div>
<script src="~/js/sample.js"></script>
